{
  "name": "research-redis-api",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js API backed by Redis (cache), MySQL (system of record) and Elasticsearch (search)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "INTEGRATION=1 node --test --test-concurrency=1 'test/integration/**/*.test.js'"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
